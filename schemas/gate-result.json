{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://molcrafts.org/schemas/ci/gate-result.json",
  "title": "GateResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "gate", "summary"],
  "properties": {
    "status": { "type": "string", "enum": ["pass", "warning", "fail"] },
    "gate": { "type": "string" },
    "summary": { "type": "string" },
    "details": { "type": "object" },
    "references": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
