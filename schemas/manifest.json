{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://molcrafts.org/schemas/ci/manifest.json",
  "title": "Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record", "source", "producer"],
  "properties": {
    "schema_version": { "type": "string" },
    "record": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "type": "string" },
        "commit": { "type": "string", "minLength": 7 },
        "ref": { "type": ["string", "null"] },
        "workflow_run": { "type": ["integer", "null"] },
        "run_attempt": { "type": ["integer", "null"] },
        "producer_version": { "type": ["string", "null"] },
        "timestamp": { "type": ["string", "null"] }
      }
    },
    "producer": { "type": "string" },
    "profile": { "type": "string" },
    "tracking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "generation": { "type": "integer", "minimum": 1 }
      }
    },
    "provenance": { "type": "object" }
  }
}
