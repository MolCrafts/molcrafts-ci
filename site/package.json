{
  "name": "@molcrafts/molcrafts-ci-site",
  "description": "MolCrafts CI engineering snapshot browser",
  "author": {
    "name": "Roy Kid"
  },
  "license": "BSD-3-Clause",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare-data": "node scripts/prepare-data.mjs",
    "seed:mock": "python3 ../scripts/seed_mock_data.py",
    "dev": "rsbuild dev",
    "dev:data": "npm run fetch-data && npm run prepare-data && PUBLIC_USE_MOCK=0 rsbuild dev",
    "build": "node scripts/build.mjs",
    "preview": "rsbuild preview",
    "typecheck": "tsc --noEmit",
    "test": "rstest run",
    "fetch-data": "node scripts/fetch-data.mjs",
    "clean-public-data": "node scripts/clean-public-data.mjs",
    "test:browser": "playwright test",
    "verify:design": "node scripts/verify-design-artifacts.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@molcrafts/design": "file:vendor/design/molcrafts-design-0.0.1.tgz",
    "@molcrafts/design-tokens": "file:vendor/design/molcrafts-design-tokens-0.0.1.tgz",
    "@molcrafts/design-vega-lite": "file:vendor/design/molcrafts-design-vega-lite-0.0.1.tgz",
    "@fluentui/react-icons": "2.0.344"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.1.10",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@rstest/core": "^0.12.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "rspack-plugin-mock": "^2.2.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.7.0",
    "@playwright/test": "1.64.0",
    "@axe-core/playwright": "4.13.0"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3"
  },
  "overrides": {
    "@molcrafts/design-tokens": "$@molcrafts/design-tokens",
    "@molcrafts/design-vega": "file:vendor/design/molcrafts-design-vega-0.0.1.tgz"
  }
}
